{
  "name": "tmux",
  "version": "3.5a-1",
  "dependencies": [
    "libevent",
    "ncurses"
  ],
  "dependencyRequirements": {
    "libevent": {
      "version": "2.1.12-1"
    },
    "ncurses": {
      "version": "6.5.0-2"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.2",
    "runtimeAbi": 5,
    "objectAbi": 3,
    "features": [
      "posix-core",
      "pthreads",
      "unix-stream",
      "unix-rights",
      "flock",
      "closefrom"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh"
  ]
}
