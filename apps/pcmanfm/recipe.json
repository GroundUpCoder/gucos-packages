{
  "name": "pcmanfm",
  "version": "1.3.2-1",
  "dependencies": [
    "libfm",
    "gtk3-x11",
    "pkgconf",
    "libintl",
    "x11-shared"
  ],
  "dependencyRequirements": {
    "libfm": {
      "version": "1.3.2-1"
    },
    "gtk3-x11": {
      "version": "3.24.43-1"
    },
    "pkgconf": {
      "version": "2.3.0-1"
    },
    "libintl": {
      "version": "0.23.1-1"
    },
    "x11-shared": {
      "version": "0.1.0-1"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.0",
    "runtimeAbi": 5,
    "features": [
      "posix-core",
      "unix-stream"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh",
    "consumer.c"
  ]
}
