{
  "name": "cairo-gobject",
  "version": "1.18.4-1",
  "dependencies": [
    "cairo",
    "gobject",
    "glib"
  ],
  "dependencyRequirements": {
    "cairo": {
      "version": "1.18.4-1"
    },
    "gobject": {
      "version": "2.84.4-1"
    },
    "glib": {
      "version": "2.84.4-1"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.0",
    "runtimeAbi": 5,
    "objectAbi": 3,
    "features": [
      "posix-core",
      "pthreads",
      "unix-stream"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh"
  ]
}
