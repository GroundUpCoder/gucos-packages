{
  "name": "sdl3-ttf",
  "version": "3.2.2-3",
  "dependencies": [
    "harfbuzz",
    "freetype",
    "glib",
    "pcre2",
    "libintl",
    "libiconv",
    "zlib"
  ],
  "dependencyRequirements": {
    "harfbuzz": {
      "version": "14.5.0-1"
    },
    "freetype": {
      "version": "2.14.1-1"
    },
    "glib": {
      "version": "2.84.4-1"
    },
    "pcre2": {
      "version": "10.46-1"
    },
    "libintl": {
      "version": "0.23.1-1"
    },
    "libiconv": {
      "version": "1.18-1"
    },
    "zlib": {
      "version": "1.3.2-1"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.0",
    "runtimeAbi": 5,
    "objectAbi": 3,
    "features": [
      "posix-core",
      "sdl3-vt",
      "pthreads"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh"
  ]
}
