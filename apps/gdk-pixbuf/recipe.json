{
  "name": "gdk-pixbuf",
  "version": "2.42.12-1",
  "dependencies": [
    "gio-core",
    "gio-listmodel",
    "gobject",
    "glib",
    "libpng",
    "libjpeg-turbo",
    "zlib",
    "libintl"
  ],
  "dependencyRequirements": {
    "gio-core": {
      "version": "2.84.4-1"
    },
    "gio-listmodel": {
      "version": "2.84.4-1"
    },
    "gobject": {
      "version": "2.84.4-1"
    },
    "glib": {
      "version": "2.84.4-1"
    },
    "libpng": {
      "version": "1.6.58-1"
    },
    "libjpeg-turbo": {
      "version": "3.1.4.1-1"
    },
    "zlib": {
      "version": "1.3.2-1"
    },
    "libintl": {
      "version": "0.23.1-1"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.0",
    "runtimeAbi": 5,
    "objectAbi": 3,
    "features": [
      "posix-core",
      "pthreads",
      "unix-stream"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh"
  ]
}
