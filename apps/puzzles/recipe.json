{
  "name": "puzzles",
  "version": "2026.9.23-2",
  "dependencies": [
    "gtk3-x11",
    "pkgconf"
  ],
  "dependencyRequirements": {
    "gtk3-x11": {
      "version": "3.24.43-1"
    },
    "pkgconf": {
      "version": "2.3.0-1"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.0",
    "runtimeAbi": 5,
    "features": [
      "posix-core",
      "unix-stream"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh",
    "gucos-puzzles-fifteen.desktop",
    "gucos-puzzles-mines.desktop",
    "gucos-puzzles-net.desktop",
    "gucos-puzzles-solo.desktop",
    "gucos-puzzles-samegame.desktop",
    "gucos-puzzles-untangle.desktop"
  ]
