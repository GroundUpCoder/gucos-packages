{
  "name": "minihb",
  "version": "0.1.0-3",
  "dependencies": [
    "freetype"
  ],
  "dependencyRequirements": {
    "freetype": {
      "version": "2.14.1-1"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.0",
    "runtimeAbi": 5,
    "objectAbi": 3,
    "features": [
      "posix-core",
      "pthreads"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh"
  ]
}
