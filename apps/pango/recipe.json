{
  "name": "pango",
  "version": "1.50.14-1",
  "dependencies": [
    "cairo",
    "fontconfig",
    "fribidi",
    "harfbuzz",
    "gio-listmodel",
    "gobject",
    "glib",
    "freetype",
    "pcre2",
    "libintl",
    "libiconv",
    "zlib"
  ],
  "dependencyRequirements": {
    "cairo": {
      "version": "1.18.4-1"
    },
    "fontconfig": {
      "version": "2.15.0-1"
    },
    "fribidi": {
      "version": "1.0.16-1"
    },
    "harfbuzz": {
      "version": "14.5.0-1"
    },
    "gio-listmodel": {
      "version": "2.84.4-1"
    },
    "gobject": {
      "version": "2.84.4-1"
    },
    "glib": {
      "version": "2.84.4-1"
    },
    "freetype": {
      "version": "2.14.1-1"
    },
    "pcre2": {
      "version": "10.46-1"
    },
    "libintl": {
      "version": "0.23.1-1"
    },
    "libiconv": {
      "version": "1.18-1"
    },
    "zlib": {
      "version": "1.3.2-1"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.0",
    "runtimeAbi": 5,
    "objectAbi": 3,
    "features": [
      "posix-core",
      "pthreads",
      "unix-stream"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh"
  ]
}
