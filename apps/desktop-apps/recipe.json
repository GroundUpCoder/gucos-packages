{
  "name": "desktop-apps",
  "version": "1.0.0-1",
  "dependencies": [
    "desktop-entries",
    "jwm",
    "xterm",
    "2048",
    "xcalc",
    "xedit",
    "xclock",
    "xeyes"
  ],
  "dependencyRequirements": {
    "desktop-entries": {
      "version": "1.0.0-1"
    },
    "jwm": {
      "version": "2.4.6-2"
    },
    "xterm": {
      "version": "411-1"
    },
    "2048": {
      "version": "0.1.0-1"
    },
    "xcalc": {
      "version": "1.1.3-1"
    },
    "xedit": {
      "version": "1.2.5-1"
    },
    "xclock": {
      "version": "1.2.1-1"
    },
    "xeyes": {
      "version": "1.3.1-1"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.0",
    "runtimeAbi": 5,
    "features": [
      "posix-core"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh",
    "gucos-desktop-2048.desktop",
    "gucos-desktop-xcalc.desktop",
    "gucos-desktop-xedit.desktop",
    "gucos-desktop-xclock.desktop",
    "gucos-desktop-xeyes.desktop"
  ]
}
