{
  "name": "glib",
  "version": "2.84.4-1",
  "dependencies": [
    "libiconv",
    "libintl",
    "pcre2"
  ],
  "dependencyRequirements": {
    "libiconv": {
      "version": "1.18-1"
    },
    "libintl": {
      "version": "0.23.1-1"
    },
    "pcre2": {
      "version": "10.46-1"
    }
  },
  "platform": {
    "target": "wasm32-wasm-posix",
    "minVersion": "1.0.0",
    "runtimeAbi": 5,
    "objectAbi": 3,
    "features": [
      "posix-core",
      "pthreads"
    ]
  },
  "inputs": [
    "source.tar",
    "build.sh",
    "test.sh"
  ]
}
